// firestore.rules (replace entire file)
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------------------------------------
    // BUCKETS (query-friendly)
    // ---------------------------------------
    function isBucketMember() {
      return signedIn() && (request.auth.uid in resource.data.memberIds);
    }

    function isBucketOwner() {
      return signedIn() && (resource.data.ownerId == request.auth.uid);
    }

    match /buckets/{bucketId} {
      allow list, get: if isBucketMember() || isBucketOwner();

      // Milestone 2B Checkpoint 4G-3: direct client Bucket creation is
      // now permanently closed. The trusted createBucket Cloud Function
      // (Admin SDK, which bypasses these rules entirely) is the sole
      // creation path - it derives ownerId/memberIds from the
      // authenticated caller and atomically writes the canonical
      // balance/ledgerOpeningBalanceMinor/ledgerBalanceMinor/currency/
      // bucketType/creationRequest state, none of which a client-facing
      // rule could ever safely express or enforce on its own (see the
      // Checkpoint 4G-1/4G-3 preflights). No exception exists for any
      // role - this follows the exact same security model already used
      // to close direct savingsTransactions writes (Checkpoint 4B).
      allow create: if false;

      // SEC-001 fix: field-level allowlists for update, for both owner and
      // non-owner members. ownerId, memberIds and target remain
      // owner-controlled only.
      //
      // Milestone 2B Checkpoint 4E: balance, ledgerBalanceMinor, and
      // ledgerOpeningBalanceMinor are existing-Bucket financial state,
      // backend-managed only - none of the three appears in either
      // allowlist below, so affectedKeys().hasOnly(...) rejects any
      // client attempt to add, change, or delete them (uniformly, since a
      // deleted field is also an affected key). The trusted
      // recordSavingsTransaction Cloud Function (Admin SDK, which
      // bypasses these rules) is the only path that updates them. Bucket
      // creation is unaffected - see the "allow create" clause above,
      // intentionally deferred to the starting-balance checkpoint.
      allow update: if (isBucketMember() || isBucketOwner())
        && request.resource.data.ownerId == resource.data.ownerId
        && (resource.data.ownerId in request.resource.data.memberIds)
        && request.resource.data.name is string
        && request.resource.data.target is number
        && request.resource.data.balance is number
        && request.resource.data.memberIds is list
        && (
          isBucketOwner()
            ? request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'target', 'color', 'memberIds', 'lastUpdatedAt', 'lastUpdatedBy'])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'color', 'lastUpdatedAt', 'lastUpdatedBy'])
        );

      allow delete: if isBucketOwner();
    }

    // ---------------------------------------
    // TRIPS (query-friendly)
    // ---------------------------------------
    function isTripMember() {
      return signedIn() && (request.auth.uid in resource.data.memberIds);
    }

    function isTripOwner() {
      return signedIn() && (resource.data.ownerId == request.auth.uid);
    }

    match /trips/{tripId} {
      allow list, get: if isTripMember() || isTripOwner();

      // Checkpoint 3F.3B.2: a canonical "YYYY-MM-DD" calendar-date-only
      // string - format only (a real calendar date, e.g. rejecting
      // "2027-02-30", is deliberately NOT re-validated here; Firestore
      // rules have no date-arithmetic primitives to do that cheaply and
      // reliably, and a malformed-but-format-valid date is a data-
      // quality nuisance, not a security or financial-integrity issue -
      // see the checkpoint report). "Start date cannot be before today"
      // is intentionally NOT enforced here either, for the same reason:
      // "today" is a client-perspective, timezone-sensitive notion, and
      // rejecting a legitimate create near a day boundary would be worse
      // than not enforcing a soft product guardrail server-side; Trip
      // Create validates this client-side instead.
      function isValidCanonicalDate(v) {
        return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Checkpoint 4B.5B (approved docs/audits/
      // TRIP_ARCHIVE_DELETE_SAFETY_PREFLIGHT_2026-09-13.md, as hardened
      // by its 4B.5A.1 amendment): missing-safe archive-state check.
      // Direct `resource.data.archivedAt == null` is unsafe for a
      // legacy Trip that has no archivedAt key at all - Firestore Rules
      // do not treat a missing map key like a JavaScript `undefined`
      // read the way a direct field comparison might imply, so every
      // archive-state check in this match block goes through this one
      // helper instead. `.get('archivedAt', null)` returns the real
      // value when present, or the given default (null) when the key is
      // absent - so both "no archivedAt key at all" (legacy) and
      // "archivedAt explicitly null" (never archived) correctly read as
      // active; only a real archivedAt timestamp reads as archived.
      function tripIsActive() {
        return resource.data.get('archivedAt', null) == null;
      }

      // Create requires: ownerId, memberIds includes owner, title string,
      // target number, saved number, imageUrl string, tripStartDate a
      // valid canonical date. location/tripEndDate may be string or null.
      //
      // Milestone 2B Checkpoint 4I: Trip creation remains a direct client
      // write for now (unlike Bucket, which moved to a trusted callable
      // in Checkpoint 4G), so this rule alone is what prevents a client
      // from injecting or forging Trip financial state. saved == 0 is
      // required - Trip has no Starting Balance product concept, so a
      // freshly-created Trip must always report a neutral zero shared
      // fund; the first trusted recordSavingsTransaction call legacy-
      // initializes the ledger from that 0 exactly like a new $0-Starting-
      // Balance Bucket already does. keys().hasOnly(...) permits exactly
      // the fields the current createTrip service legitimately writes -
      // critically, ledgerOpeningBalanceMinor, ledgerBalanceMinor, and
      // currency are NOT in this list. Without this, a client could set
      // both ledger fields at create time and have the trusted backend
      // treat them as already-initialized truth (bypassing legacy
      // initialization and seeding forged financial state), or set only
      // one and permanently break the Trip via the backend's partial-
      // ledger failed-precondition guard - see recordSavingsTransaction.ts.
      //
      // Checkpoint 3F.3B.2: tripStartDate is required (matching the
      // product decision that every trip created from this checkpoint
      // forward must have a real start date) - tripEndDate stays
      // optional/nullable, and when both are present as valid dates,
      // end must be on/after start (a plain string >= comparison is
      // correct here because same-length ISO "YYYY-MM-DD" strings sort
      // lexicographically in calendar order).
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.title is string
        && request.resource.data.target is number
        && request.resource.data.saved is number
        && request.resource.data.saved == 0
        && request.resource.data.imageUrl is string
        && (
          !(request.resource.data.keys().hasAny(['location']))
          || request.resource.data.location is string
          || request.resource.data.location == null
        )
        && isValidCanonicalDate(request.resource.data.tripStartDate)
        && (
          !(request.resource.data.keys().hasAny(['tripEndDate']))
          || request.resource.data.tripEndDate == null
          || (
            isValidCanonicalDate(request.resource.data.tripEndDate)
            && request.resource.data.tripEndDate >= request.resource.data.tripStartDate
          )
        )
        && request.resource.data.keys().hasOnly([
          'ownerId', 'memberIds', 'title', 'location', 'target', 'saved',
          'imageUrl', 'tripStartDate', 'tripEndDate', 'createdAt',
          'lastUpdatedAt', 'lastUpdatedBy'
        ]);

      // SEC-001 fix: field-level allowlists for update, for both owner and
      // non-owner members. ownerId, memberIds and target remain
      // owner-controlled only.
      //
      // Milestone 2B Checkpoint 4H: saved, ledgerBalanceMinor, and
      // ledgerOpeningBalanceMinor are existing-Trip financial state,
      // backend-managed only - mirrors the Bucket balance lockdown
      // (Checkpoint 4E) exactly. None of the three appears in either
      // allowlist below, so affectedKeys().hasOnly(...) rejects any
      // client attempt to add, change, or delete them (uniformly, since a
      // deleted field is also an affected key). The trusted
      // recordSavingsTransaction Cloud Function (Admin SDK, which
      // bypasses these rules) is the only path that updates them. Trip
      // creation is unaffected - saved's create-time exposure is a
      // separate, deliberately deferred gap (see the "allow create"
      // clause above), tracked for a dedicated follow-up checkpoint.
      // Checkpoint 3F.3B.3: tripStartDate/tripEndDate join the OWNER-only
      // update allowlist (a member may still never touch them, matching
      // "Owner may update dates; Member may NOT"). The shape checks below
      // apply to the POST-write document regardless of which fields this
      // particular update actually touched - that's safe/correct, not
      // overly strict, because it only ever re-affirms an invariant the
      // create rule already established (a trip with no dates at all has
      // neither key present, so both checks short-circuit via
      // !keys().hasAny(...) and an unrelated field-only update, like a
      // title rename, is unaffected either way).
      // Checkpoint 4B.5B: tripIsActive() is now a hard prerequisite for
      // this ENTIRE ordinary update path - once a Trip is archived, this
      // clause can never succeed for any field, which is exactly the
      // "no metadata/member editing once archived" freeze the approved
      // preflight requires (§5.E/§5.F/§11), enforced with one guard
      // rather than per-field special-casing. This does not widen any
      // pre-existing permission - it only narrows when the already-
      // existing rule below may apply.
      allow update: if tripIsActive()
        && (isTripMember() || isTripOwner())
        && request.resource.data.ownerId == resource.data.ownerId
        && (resource.data.ownerId in request.resource.data.memberIds)
        && request.resource.data.title is string
        && request.resource.data.target is number
        && request.resource.data.saved is number
        && request.resource.data.imageUrl is string
        && request.resource.data.memberIds is list
        && (
          !(request.resource.data.keys().hasAny(['tripStartDate']))
          || isValidCanonicalDate(request.resource.data.tripStartDate)
        )
        && (
          !(request.resource.data.keys().hasAny(['tripEndDate']))
          || request.resource.data.tripEndDate == null
          || (
            isValidCanonicalDate(request.resource.data.tripEndDate)
            && isValidCanonicalDate(request.resource.data.tripStartDate)
            && request.resource.data.tripEndDate >= request.resource.data.tripStartDate
          )
        )
        && (
          isTripOwner()
            ? request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'title', 'location', 'target', 'imageUrl', 'memberIds',
                  'tripStartDate', 'tripEndDate', 'lastUpdatedAt', 'lastUpdatedBy'
                ])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'location', 'imageUrl', 'lastUpdatedAt', 'lastUpdatedBy'])
        );

      // Checkpoint 4B.5B: the one-directional archive transition -
      // owner-only, and a completely separate `allow update` clause
      // (Firestore Rules OR's multiple `allow update` statements for the
      // same match together) rather than folded into the giant
      // expression above, so this narrow, security-critical branch stays
      // easy to read and audit on its own.
      //   - Owner-only, matching every other owner-gated Trip mutation.
      //   - tripIsActive() means this can only ever fire ONCE per Trip -
      //     an already-archived Trip can never archive again, and (since
      //     this is the ONLY clause that can touch archivedAt/archivedBy
      //     at all) can never have that metadata changed or removed
      //     either. There is no unarchive transition anywhere in this
      //     match block.
      //   - affectedKeys().hasOnly(['archivedAt', 'archivedBy']) means
      //     this transition can NEVER be combined with any other field
      //     change in the same write - archiving never smuggles in a
      //     title/date/membership edit alongside it.
      //   - archivedAt must equal request.time (the standard Rules idiom
      //     for a serverTimestamp() write) - a client can never backdate
      //     or forward-date its own archive.
      //   - archivedBy must equal the authenticated caller - never
      //     forgeable to name someone else.
      allow update: if isTripOwner()
        && tripIsActive()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['archivedAt', 'archivedBy'])
        && request.resource.data.archivedAt == request.time
        && request.resource.data.archivedBy == request.auth.uid;

      // Checkpoint 4B.5B: a Trip is never client-hard-deletable (approved
      // preflight §6) - "Delete Trip" is archiving instead (above).
      // Archiving already satisfies the real product need without ever
      // destroying data; see the preflight for why a conditional
      // "delete only if no financial history" rule was rejected as
      // fragile (every current AND future financial-child-record type
      // would need checking, forever).
      allow delete: if false;
    }

    // ---------------------------------------
    // SAVINGS TRANSACTIONS (Milestone 2B ledger)
    // ---------------------------------------
    // Append-only, and (as of Checkpoint 4B) client-write-closed
    // entirely: reads remain authorized here, but every create/update/
    // delete is unconditionally denied for every client. The trusted
    // recordSavingsTransaction Cloud Function (Admin SDK, which bypasses
    // these rules) is the sole write path - see the "allow create"
    // clause below for why. Read access is based solely on the CURRENT
    // ownerId/memberIds of the referenced bucket or trip - never on a
    // Bucket's linkedTripId. A trip_personal Bucket's privacy is
    // governed by that Bucket's own membership; being the owner of the
    // linked Trip grants no access to it. Admin-role permissions are
    // deferred until the membership subcollection infrastructure exists
    // (Milestone 2A design freeze) - only ownerId/memberIds are
    // consulted here.
    match /savingsTransactions/{transactionId} {

      function validResourceType(t) {
        return t == 'bucket' || t == 'trip';
      }

      function parentExists(resourceType, resourceId) {
        return resourceType == 'bucket'
          ? exists(/databases/$(database)/documents/buckets/$(resourceId))
          : exists(/databases/$(database)/documents/trips/$(resourceId));
      }

      function parentData(resourceType, resourceId) {
        return resourceType == 'bucket'
          ? get(/databases/$(database)/documents/buckets/$(resourceId)).data
          : get(/databases/$(database)/documents/trips/$(resourceId)).data;
      }

      function isParentMember(resourceType, resourceId, uid) {
        return uid in parentData(resourceType, resourceId).memberIds;
      }

      function isParentOwner(resourceType, resourceId, uid) {
        return parentData(resourceType, resourceId).ownerId == uid;
      }

      function canAccessParent(resourceType, resourceId) {
        return signedIn()
          && resourceType is string
          && validResourceType(resourceType)
          && resourceId is string
          && parentExists(resourceType, resourceId)
          && (
            isParentMember(resourceType, resourceId, request.auth.uid)
            || isParentOwner(resourceType, resourceId, request.auth.uid)
          );
      }

      allow get, list: if resource.data.resourceType is string
        && resource.data.resourceId is string
        && canAccessParent(resource.data.resourceType, resource.data.resourceId);

      // Milestone 2B Checkpoint 4B: client create is now permanently
      // closed. The trusted recordSavingsTransaction Cloud Function
      // (Admin SDK, which bypasses these rules entirely) is the sole
      // write path - it atomically maintains ledgerBalanceMinor and the
      // balance/saved compatibility cache, enforces non-negative
      // withdrawals, performs legacy-opening-balance initialization, and
      // enforces idempotency, none of which these client-facing rules
      // could ever fully guarantee on their own (see the Checkpoint 4
      // architecture preflight). No exception exists for self,
      // owner-on-behalf, or any other role - a client can never bypass
      // the Function by constructing an otherwise-perfectly-valid
      // document.
      allow create: if false;

      // Append-only: no client may ever modify or remove a savings
      // transaction, including the resource owner.
      allow update, delete: if false;
    }

    // ---------------------------------------
    // TRIP EXPENSES / TRIP EXPENSE SPLITS (Checkpoint 4C.2B, approved
    // docs/audits/TRIP_OUT_OF_POCKET_EXPENSE_PERSISTENCE_PREFLIGHT_
    // 2026-09-15.md as hardened by 4C.1A/4C.1B, §13)
    // ---------------------------------------
    // The trusted recordTripExpense Cloud Function (Admin SDK, which
    // bypasses these rules entirely) is the SOLE write path for both
    // collections below - it atomically derives createdBy, computes and
    // validates splits, and enforces creator-bound idempotency, none of
    // which a client-facing rule could ever safely express (see
    // functions/src/callables/recordTripExpense.ts and the preflight
    // §6-§9). Client access here is read-only, full stop: no field-level
    // update exceptions, no creator exception, no owner write exception,
    // no archived-Trip write exception - mirrors savingsTransactions'
    // identical append-only, trusted-write-only posture exactly.
    //
    // canAccessTripById() is declared here at the OUTER scope (matching
    // signedIn()'s own placement above), not nested inside either match
    // block below, because BOTH match /tripExpenses and
    // match /tripExpenseSplits need to call it - a Firestore Rules
    // function declared inside one match block is not visible to a
    // sibling match block. Deliberately does NOT inspect archivedAt -
    // per the preflight §12/§13, an archived Trip's Expense/Split
    // history remains fully readable to its current members/owner;
    // archiving only closes NEW Expense creation, and only through the
    // trusted callable (Admin SDK, bypasses these Rules) - never this
    // read-only surface. Authorization is based solely on the Trip's
    // CURRENT memberIds/ownerId (read fresh via get(), as they stand
    // right now) - never on createdBy, payerUid, split membership,
    // historical membership, or clientRequestId. A member later removed
    // from the Trip loses direct-read access to that Trip's Expense/
    // Split history immediately, even for an Expense they personally
    // created - the trusted callable's own idempotent-replay
    // reconciliation for that same former member is a separate, purely
    // server-side concern (preflight §5.1) this client-facing read rule
    // has no bearing on and does not need to accommodate.
    //
    // Mirrors savingsTransactions' canAccessParent() in spirit, simplified
    // since the parent here is always a Trip (Expenses are Trip-only,
    // audit §1) - no bucket/trip discriminator branch is needed. Uses
    // direct `.data.memberIds`/`.data.ownerId` access (not a `.get(...,
    // default)` missing-safe wrapper) to match isTripMember()/isTripOwner()
    // above exactly: a malformed (non-list) memberIds value makes the
    // `in` check itself evaluate to an error, which Firestore Rules
    // treats as `false` for that operand - CEL's `||` still lets the
    // independent `ownerId == uid` check succeed on its own merits, so an
    // owner is not accidentally locked out by a corrupted memberIds
    // field, while a non-owner correctly fails closed (tested explicitly
    // - see tests/firestore-rules/tripExpenses.rules.test.js).
    function canAccessTripById(tripId) {
      return signedIn()
        && tripId is string
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && (
          request.auth.uid in
            get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
          || get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId
              == request.auth.uid
        );
    }

    // Checkpoint 5A (docs/audits/TRIP_WALLET_MILESTONE_PREFLIGHT_
    // 2026-10-06.md, as hardened by its 5.0A amendment): a cross-
    // collection "is the caller currently this Trip's owner" check,
    // parameterized like canAccessTripById above (and declared at this
    // same outer scope so tripTerms/tripInvitations/
    // tripMembershipAcceptances can all share it). Used only by the three
    // new inert match blocks below - never by trips/tripExpenses/
    // tripExpenseSplits/tripSettlements, whose own existing isTripOwner()
    // is untouched.
    function isTripOwnerById(tripId) {
      return signedIn()
        && tripId is string
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId
            == request.auth.uid;
    }

    // Checkpoint 5A: true if the CALLER holds any tripInvitations record
    // (regardless of status - pending, accepted, declined, or cancelled)
    // for this Trip, via the deterministic `{tripId}_{inviteeUid}` id
    // (see match /tripInvitations below). Lets an invited-but-not-yet-
    // accepted user read that Trip's terms for pre-join disclosure
    // (Master Spec §12.2) without granting them canAccessTripById's
    // membership-scoped access to anything else - this function is never
    // used by any financial collection's Rules.
    function hasTripInvitationRecord(tripId) {
      return signedIn()
        && tripId is string
        && exists(
          /databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)
        );
    }

    // Checkpoint 5A.1 (item 4): a STRICTER version of
    // hasTripInvitationRecord, used only by tripMembershipAcceptances'
    // create rule below - a cancelled, declined, or expired-while-still-
    // "pending" invitation must never be usable to manufacture a fresh
    // terms-acceptance record. Deliberately permits BOTH orderings a
    // future 5C might choose between ("terms acceptance, then invitation
    // acceptance" vs. "invitation acceptance, then terms acceptance"):
    // the invitation may be either still "pending" (and unexpired) OR
    // already "accepted" - either represents a live, un-revoked
    // invitation relationship. hasTripInvitationRecord itself (above) is
    // intentionally left permissive for tripTerms' own pre-join-
    // disclosure read access, which has no such abuse concern (reading
    // disclosure content grants nothing).
    function hasActionableTripInvitationRecord(tripId) {
      return signedIn()
        && tripId is string
        && exists(
          /databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)
        )
        && (
          get(
            /databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)
          ).data.status == 'accepted'
          || (
            get(
              /databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)
            ).data.status == 'pending'
            && get(
              /databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)
            ).data.expiresAt > request.time
          )
        );
    }

    match /tripExpenses/{expenseId} {
      // Document id conveys no authority whatsoever - access follows
      // ONLY the resource's own tripId field, checked fresh against that
      // Trip's CURRENT membership/ownership on every read.
      allow get, list: if resource.data.tripId is string
        && canAccessTripById(resource.data.tripId);

      // No client create/update/delete, for any role, ever - see the
      // section header above for why.
      allow create, update, delete: if false;
    }

    match /tripExpenseSplits/{splitDocumentId} {
      // Split documents carry their own denormalized tripId (preflight
      // §7/§13) - this rule never looks up the parent Expense document at
      // all, only the parent Trip, exactly as frozen in the preflight.
      // Never inferred from userId - a current Trip member may read
      // every split belonging to their Trip's Expenses, not only splits
      // where they are the named participant (these are shared Trip
      // financial records, not private-to-the-named-user documents).
      allow get, list: if resource.data.tripId is string
        && canAccessTripById(resource.data.tripId);

      allow create, update, delete: if false;
    }

    // ---------------------------------------
    // TRIP SETTLEMENTS (Checkpoint 4E.2, approved docs/audits/
    // TRIP_BALANCES_SETTLEMENTS_PREFLIGHT_2026-09-28.md §10/§13, as
    // hardened by 4E.0A) - reuses canAccessTripById() verbatim (declared
    // above, in this same outer scope), matching tripExpenses/
    // tripExpenseSplits' identical read-only, trusted-write-only posture
    // exactly. The trusted recordTripSettlement/reverseTripSettlement
    // Cloud Functions (Admin SDK, which bypass these rules entirely) are
    // the SOLE write path - no client create/update/delete, for any
    // role, ever, including the Settlement's own recipient (toUid),
    // debtor (fromUid), or the Trip owner. Deliberately does NOT inspect
    // archivedAt - a current Trip member's Settlement history remains
    // fully readable on an archived Trip, exactly like tripExpenses.
    // ---------------------------------------
    match /tripSettlements/{settlementId} {
      // Document id conveys no authority whatsoever - access follows
      // ONLY the resource's own tripId field, checked fresh against that
      // Trip's CURRENT membership/ownership on every read.
      allow get, list: if resource.data.tripId is string
        && canAccessTripById(resource.data.tripId);

      allow create, update, delete: if false;
    }

    // ---------------------------------------
    // TRIP TERMS / INVITATIONS / MEMBERSHIP ACCEPTANCE (Checkpoint 5A,
    // docs/audits/TRIP_WALLET_MILESTONE_PREFLIGHT_2026-10-06.md as
    // hardened by its 5.0A amendment)
    //
    // FROZEN INVARIANT, enforced by every rule in this section: none of
    // these three collections grants Trip financial authorization. None
    // is read by, written by, or referenced from any trusted financial
    // callable (recordSavingsTransaction, recordSharedStashExpense,
    // reverseSharedStashExpense, recordTripExpense, reverseTripExpense,
    // recordTripSettlement, reverseTripSettlement). None of these rules
    // ever writes to, or is consulted by, `trips.memberIds`. Activating
    // real financial membership from an accepted invitation is explicitly
    // deferred to a future checkpoint (5C), gated on a withdrawal-ceiling
    // checkpoint (5B) landing first - see the preflight's revised §10.
    // ---------------------------------------

    // TRIP TERMS: immutable, append-only disclosure/agreement content.
    // Checkpoint 5A.1 (item 5): publishing is now EXCLUSIVELY a trusted
    // callable (functions/src/callables/publishTripTerms.ts) - direct
    // client creation is closed, matching every other financial/record
    // collection's posture in this file. This exists because a
    // client-computed "max version + 1" is not an authoritative answer
    // Rules can verify, and concurrent publishes could otherwise produce
    // two competing "version N" documents. The trusted callable instead
    // maintains the tripTermsCurrent/{tripId} pointer document (below)
    // inside the SAME Firestore transaction that creates each new
    // version - Firestore's transaction conflict detection guarantees
    // concurrent publish attempts serialize against that one pointer
    // document, so version numbers can never collide or skip
    // ambiguously. "The current version" is never stored on the Trip
    // document itself - this checkpoint makes zero changes to the
    // `trips` collection or its Rules.
    match /tripTerms/{termsId} {
      // A current Trip member/owner may read every version (historical
      // included); an invited-but-not-yet-accepted user may also read
      // (pre-join disclosure, Master Spec §12.2) via
      // hasTripInvitationRecord - never a stranger with neither relation.
      allow get, list: if resource.data.tripId is string
        && (
          canAccessTripById(resource.data.tripId)
          || hasTripInvitationRecord(resource.data.tripId)
        );

      // Trusted callable only (Admin SDK bypasses these Rules) - see the
      // match-block comment above for why a direct client create can
      // never safely express "exactly one authoritative next version."
      allow create: if false;

      // Historical versions must never be mutable - no exception for
      // any role, including the Trip owner who created the document.
      allow update, delete: if false;
    }

    // TRIP TERMS CURRENT POINTER: one document per Trip
    // (tripTermsCurrent/{tripId} - the Trip's own id IS this document's
    // id, never a field inside it), naming the single authoritative
    // "current" TripTerms document. Checkpoint 5A.1 (items 5/6): this is
    // what lets tripMembershipAcceptances' create rule (below) verify
    // "the referenced termsDocId is the CURRENTLY required version"
    // without ever trusting a client-computed max - it reads this exact
    // document instead. Written only inside publishTripTerms.ts's own
    // transaction, atomically alongside the new tripTerms document it
    // names - never out of step with it.
    match /tripTermsCurrent/{tripId} {
      allow get: if canAccessTripById(tripId) || hasTripInvitationRecord(tripId);

      allow create, update, delete: if false;
    }

    // TRIP INVITATIONS: deterministic id `{tripId}_{inviteeUid}` - the
    // entire uniqueness mechanism for "at most one invitation record ever
    // exists for a given (tripId, inviteeUid) pair" (mirrors
    // createBucket.ts's own deterministic-id convention). Client creation
    // is permanently closed: issuing an invitation requires resolving
    // inviteeEmail to a uid server-side (reusing lookupUserByEmail's own
    // Admin-SDK lookup pattern, never a public Firestore email-query
    // surface) - see functions/src/callables/createTripInvitation.ts.
    // Responding to an already-issued invitation (accept/decline/cancel),
    // by contrast, is a direct client write: each is a one-way terminal
    // status transition with zero financial consequence, so no trusted
    // callable is needed for it (mirrors the archivedAt one-way-
    // transition pattern already used for Trips).
    match /tripInvitations/{invitationId} {
      // Only the named invitee or the Trip owner may read an invitation -
      // never an outsider, and never by guessing another trip's id (every
      // check below re-derives authorization from the document's own
      // tripId/inviteeUid fields, exactly like every other Trip-scoped
      // collection in this file).
      //
      // Checkpoint 5A.1 (item 8): deliberately NOT a single `tripId is
      // string && (...)` guard wrapping both branches (as every other
      // collection in this file uses) - Firestore evaluates a `list`
      // query's rule using ONLY the query's own filters, never real
      // per-document data, so a blanket `resource.data.tripId is string`
      // prefix makes ANY query that does not itself filter on tripId
      // (such as the invitee's own fetchPendingInvitationsForUser, which
      // filters by inviteeUid only) unconditionally fail with
      // "property tripId is undefined," even though every real document
      // actually has that field - a Firestore list-rule limitation, not
      // a data problem. Structuring the invitee's own branch so it can be
      // proven true (or false) directly from the query's inviteeUid
      // filter ALONE, with no reference to tripId at all, is what lets
      // that query (and the symmetric owner-by-tripId query, which
      // equally never touches inviteeUid) each succeed from their own
      // query's constraints independently.
      allow get, list: if signedIn()
        && (
          resource.data.inviteeUid == request.auth.uid
          || (resource.data.tripId is string && isTripOwnerById(resource.data.tripId))
        );

      allow create: if false;

      // Invitee: pending + UNEXPIRED -> accepted only (Checkpoint 5A.1,
      // item 2). An expired invitation must never become "accepted" -
      // expiry is enforced here, at the actual write boundary, not only
      // by the domain-layer isTripInvitationExpired helper the UI uses
      // for display. `resource.data.expiresAt > request.time` reads the
      // ALREADY-PERSISTED expiresAt (immutable - see the unchanged-field
      // checks below) against the server's own clock at write time, so
      // this can never be spoofed by a stale client-side "now".
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.inviteeUid == request.auth.uid
        && resource.data.expiresAt > request.time
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.inviteeUid == resource.data.inviteeUid
        && request.resource.data.inviterUid == resource.data.inviterUid
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.status == 'accepted'
        && request.resource.data.respondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt']);

      // Invitee: pending -> declined, REGARDLESS of expiry (Checkpoint
      // 5A.1, item 2's documented choice: declining an already-expired
      // invitation is harmless bookkeeping - it only ever narrows what
      // the invitee is recorded as having wanted, never grants anything,
      // so there is no reason to block it once expired).
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.inviteeUid == request.auth.uid
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.inviteeUid == resource.data.inviteeUid
        && request.resource.data.inviterUid == resource.data.inviterUid
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.status == 'declined'
        && request.resource.data.respondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt']);

      // Owner: pending -> cancelled, regardless of expiry (Checkpoint
      // 5A.1, item 2's documented choice: cancelling a (possibly already
      // expired) pending invitation is always safe - it only ever closes
      // off access, never grants it, so the owner may use it to clean up
      // a stale invite). Same one-way shape as the invitee
      // transition above, but owner-only and only to "cancelled".
      allow update: if isTripOwnerById(resource.data.tripId)
        && resource.data.status == 'pending'
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.inviteeUid == resource.data.inviteeUid
        && request.resource.data.inviterUid == resource.data.inviterUid
        && request.resource.data.inviteeEmail == resource.data.inviteeEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.status == 'cancelled'
        && request.resource.data.respondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'respondedAt']);

      allow delete: if false;
    }

    // TRIP MEMBERSHIP ACCEPTANCE: immutable, append-only proof that `uid`
    // accepted the EXACT tripTerms document `termsDocId` at `acceptedAt`.
    // Deterministic id `{tripId}_{uid}_{termsDocId}` - a member may hold
    // more than one of these over a Trip's lifetime (one per terms
    // version they've accepted); none is ever updated or deleted, so a
    // later terms edit can never retroactively imply a member accepted
    // content they never saw. Creating an acceptance record also requires
    // an existing tripInvitations record for (tripId, caller) - this ties
    // acceptance to a real invitation without requiring it to be in any
    // particular status, keeping this checkpoint's model minimal.
    match /tripMembershipAcceptances/{acceptanceId} {
      allow get, list: if resource.data.tripId is string
        && (
          (signedIn() && resource.data.uid == request.auth.uid)
          || isTripOwnerById(resource.data.tripId)
        );

      // Checkpoint 5A.1 (items 4/6): create requires (a) an un-revoked,
      // unexpired invitation relationship (hasActionableTripInvitationRecord,
      // not the looser hasTripInvitationRecord used for terms reads), and
      // (b) that termsDocId is EXACTLY the Trip's current authoritative
      // version per tripTermsCurrent/{tripId} - never a stale historical
      // version, and never a value the client alone decided was "current".
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tripId is string
        && request.resource.data.termsDocId is string
        && request.resource.data.acceptedTermsVersion is number
        && request.resource.data.acceptedAt == request.time
        && hasActionableTripInvitationRecord(request.resource.data.tripId)
        && exists(
          /databases/$(database)/documents/tripTerms/$(request.resource.data.termsDocId)
        )
        && get(
          /databases/$(database)/documents/tripTerms/$(request.resource.data.termsDocId)
        ).data.tripId == request.resource.data.tripId
        && get(
          /databases/$(database)/documents/tripTerms/$(request.resource.data.termsDocId)
        ).data.version == request.resource.data.acceptedTermsVersion
        && exists(
          /databases/$(database)/documents/tripTermsCurrent/$(request.resource.data.tripId)
        )
        && get(
          /databases/$(database)/documents/tripTermsCurrent/$(request.resource.data.tripId)
        ).data.currentTermsDocId == request.resource.data.termsDocId
        && acceptanceId == request.resource.data.tripId + '_'
            + request.resource.data.uid + '_' + request.resource.data.termsDocId
        && request.resource.data.keys().hasOnly([
          'tripId', 'uid', 'termsDocId', 'acceptedTermsVersion', 'acceptedAt'
        ]);

      allow update, delete: if false;
    }

    // ---------------------------------------
    // USERS
    // ---------------------------------------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /publicUsers/{uid} {
      // Milestone 1B checkpoint 3B: read/list scope intentionally left
      // unchanged for now - narrowing member-discovery access is a
      // separate, larger decision, not part of this checkpoint.
      allow read: if signedIn();

      // Approved profile shape only. emailLower must never be written
      // again (see Milestone 1B privacy inspection) - it is deliberately
      // excluded from this allowlist.
      //
      // createdAt is also intentionally excluded: the private `users/{uid}`
      // document is the source of account-lifecycle metadata, not
      // publicUsers. This also fixes a write-order bug where AuthContext's
      // upsert (no createdAt) could create the document first, turning a
      // later registration write that included createdAt into an update
      // that adds a new field - which the update rule below has never
      // allowed. Existing documents that already contain createdAt remain
      // fully compatible; see the update rule's comment.
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.keys()
            .hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt']);

      // Only the document owner may update, only approved fields may
      // change value, and uid/document ownership is immutable.
      //
      // IMPORTANT: this uses diff().affectedKeys() (changed VALUES only),
      // not keys() (all keys present). A legacy document that already
      // contains emailLower and/or createdAt can still be updated as long
      // as those fields' values are left unchanged - they simply never
      // appear in the diff, so no live-data migration is required for
      // existing profiles to remain editable. Any attempt to add, change,
      // or restore emailLower or createdAt on any document (legacy or
      // modern) is blocked because neither is in this allowlist.
      allow update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'updatedAt']);

      // Delete: self-only, unchanged from prior behavior.
      allow delete: if signedIn() && uid == request.auth.uid;
    }
  }
}
