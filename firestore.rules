// firestore.rules (replace entire file)
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------------------------------------
    // BUCKETS (query-friendly)
    // ---------------------------------------
    function isBucketMember() {
      return signedIn() && (request.auth.uid in resource.data.memberIds);
    }

    function isBucketOwner() {
      return signedIn() && (resource.data.ownerId == request.auth.uid);
    }

    match /buckets/{bucketId} {
      allow list, get: if isBucketMember() || isBucketOwner();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.target is number
        && request.resource.data.balance is number;

      // SEC-001 fix: field-level allowlists for update, for both owner and
      // non-owner members. ownerId, memberIds, balance and target remain
      // owner-controlled only. These fields remain prototype/planning
      // numbers, NOT real-money balances - no ledger exists yet (see
      // Milestone 1 audit, SEC-001).
      allow update: if (isBucketMember() || isBucketOwner())
        && request.resource.data.ownerId == resource.data.ownerId
        && (resource.data.ownerId in request.resource.data.memberIds)
        && request.resource.data.name is string
        && request.resource.data.target is number
        && request.resource.data.balance is number
        && request.resource.data.memberIds is list
        && (
          isBucketOwner()
            ? request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'target', 'balance', 'color', 'memberIds', 'lastUpdatedAt', 'lastUpdatedBy'])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'color', 'lastUpdatedAt', 'lastUpdatedBy'])
        );

      allow delete: if isBucketOwner();
    }

    // ---------------------------------------
    // TRIPS (query-friendly)
    // ---------------------------------------
    function isTripMember() {
      return signedIn() && (request.auth.uid in resource.data.memberIds);
    }

    function isTripOwner() {
      return signedIn() && (resource.data.ownerId == request.auth.uid);
    }

    match /trips/{tripId} {
      allow list, get: if isTripMember() || isTripOwner();

      // Create requires: ownerId, memberIds includes owner, title string,
      // target number, saved number, imageUrl string. location may be string or null.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.title is string
        && request.resource.data.target is number
        && request.resource.data.saved is number
        && request.resource.data.imageUrl is string
        && (
          !(request.resource.data.keys().hasAny(['location']))
          || request.resource.data.location is string
          || request.resource.data.location == null
        );

      // SEC-001 fix: field-level allowlists for update, for both owner and
      // non-owner members. ownerId, memberIds, target and saved remain
      // owner-controlled only. These fields remain prototype/planning
      // numbers, NOT real-money balances - no ledger exists yet (see
      // Milestone 1 audit, SEC-001).
      // Note: no current screen calls update() on trips; this is
      // defense-in-depth hardening with no observed UI impact.
      allow update: if (isTripMember() || isTripOwner())
        && request.resource.data.ownerId == resource.data.ownerId
        && (resource.data.ownerId in request.resource.data.memberIds)
        && request.resource.data.title is string
        && request.resource.data.target is number
        && request.resource.data.saved is number
        && request.resource.data.imageUrl is string
        && request.resource.data.memberIds is list
        && (
          isTripOwner()
            ? request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'location', 'target', 'saved', 'imageUrl', 'memberIds', 'lastUpdatedAt', 'lastUpdatedBy'])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'location', 'imageUrl', 'lastUpdatedAt', 'lastUpdatedBy'])
        );

      // Delete: only owner
      allow delete: if isTripOwner();
    }

    // ---------------------------------------
    // SAVINGS TRANSACTIONS (Milestone 2B ledger)
    // ---------------------------------------
    // Append-only: create only, never update/delete (corrections happen
    // via a new reversal transaction, never a mutation - see
    // src/types/domain/savingsTransaction.ts). Access (both read and
    // create) is based solely on the CURRENT ownerId/memberIds of the
    // referenced bucket or trip - never on a Bucket's linkedTripId. A
    // trip_personal Bucket's privacy is governed by that Bucket's own
    // membership; being the owner of the linked Trip grants no access to
    // it. Admin-role permissions are deferred until the membership
    // subcollection infrastructure exists (Milestone 2A design freeze) -
    // only ownerId/memberIds are consulted here.
    //
    // `id` is intentionally not part of the stored/allowed field set:
    // every existing mapper in this repo (subscribeToUserBuckets,
    // mapTripDocument, subscribeToPublicUsersByIds) derives `id`/`uid`
    // from the Firestore document ID itself, never from a stored field
    // matching SavingsTransactionBase's own `id: string`. The persisted
    // payload here follows that same convention - `id` is supplied by
    // the future read-side mapper, not stored.
    match /savingsTransactions/{transactionId} {

      function validResourceType(t) {
        return t == 'bucket' || t == 'trip';
      }

      function parentExists(resourceType, resourceId) {
        return resourceType == 'bucket'
          ? exists(/databases/$(database)/documents/buckets/$(resourceId))
          : exists(/databases/$(database)/documents/trips/$(resourceId));
      }

      function parentData(resourceType, resourceId) {
        return resourceType == 'bucket'
          ? get(/databases/$(database)/documents/buckets/$(resourceId)).data
          : get(/databases/$(database)/documents/trips/$(resourceId)).data;
      }

      function isParentMember(resourceType, resourceId, uid) {
        return uid in parentData(resourceType, resourceId).memberIds;
      }

      function isParentOwner(resourceType, resourceId, uid) {
        return parentData(resourceType, resourceId).ownerId == uid;
      }

      // parent.currency if it exists and is a string, else the legacy
      // "USD" fallback for resources created before Milestone 2A added
      // an optional currency field.
      function parentEffectiveCurrency(resourceType, resourceId) {
        return ('currency' in parentData(resourceType, resourceId))
            && (parentData(resourceType, resourceId).currency is string)
          ? parentData(resourceType, resourceId).currency
          : 'USD';
      }

      function canAccessParent(resourceType, resourceId) {
        return signedIn()
          && resourceType is string
          && validResourceType(resourceType)
          && resourceId is string
          && parentExists(resourceType, resourceId)
          && (
            isParentMember(resourceType, resourceId, request.auth.uid)
            || isParentOwner(resourceType, resourceId, request.auth.uid)
          );
      }

      allow get, list: if resource.data.resourceType is string
        && resource.data.resourceId is string
        && canAccessParent(resource.data.resourceType, resource.data.resourceId);

      allow create: if signedIn()
        && request.resource.data.resourceType is string
        && validResourceType(request.resource.data.resourceType)
        && request.resource.data.resourceId is string
        && parentExists(request.resource.data.resourceType, request.resource.data.resourceId)
        && request.resource.data.memberUid is string
        && isParentMember(request.resource.data.resourceType, request.resource.data.resourceId, request.resource.data.memberUid)
        && request.resource.data.recordedBy is string
        && request.resource.data.recordedBy == request.auth.uid
        && (
          request.auth.uid == request.resource.data.memberUid
          || isParentOwner(request.resource.data.resourceType, request.resource.data.resourceId, request.auth.uid)
        )
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && (
          request.resource.data.type == 'contribution'
          || request.resource.data.type == 'withdrawal'
        )
        && request.resource.data.currency is string
        && request.resource.data.currency == parentEffectiveCurrency(request.resource.data.resourceType, request.resource.data.resourceId)
        && request.resource.data.createdAt == request.time
        && (
          !('note' in request.resource.data)
          || request.resource.data.note is string
        )
        && (
          !('occurredAt' in request.resource.data)
          || request.resource.data.occurredAt is timestamp
        )
        && (
          !('reversalOf' in request.resource.data)
          || request.resource.data.reversalOf is string
          || request.resource.data.reversalOf == null
        )
        && request.resource.data.keys().hasOnly([
             'resourceType', 'resourceId', 'memberUid', 'recordedBy',
             'amountMinor', 'currency', 'note', 'occurredAt', 'createdAt',
             'reversalOf', 'type'
           ])
        && request.resource.data.keys().hasAll([
             'resourceType', 'resourceId', 'memberUid', 'recordedBy',
             'amountMinor', 'currency', 'createdAt', 'type'
           ]);

      // Append-only: no client may ever modify or remove a savings
      // transaction, including the resource owner.
      allow update, delete: if false;
    }

    // ---------------------------------------
    // USERS
    // ---------------------------------------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /publicUsers/{uid} {
      // Milestone 1B checkpoint 3B: read/list scope intentionally left
      // unchanged for now - narrowing member-discovery access is a
      // separate, larger decision, not part of this checkpoint.
      allow read: if signedIn();

      // Approved profile shape only. emailLower must never be written
      // again (see Milestone 1B privacy inspection) - it is deliberately
      // excluded from this allowlist.
      //
      // createdAt is also intentionally excluded: the private `users/{uid}`
      // document is the source of account-lifecycle metadata, not
      // publicUsers. This also fixes a write-order bug where AuthContext's
      // upsert (no createdAt) could create the document first, turning a
      // later registration write that included createdAt into an update
      // that adds a new field - which the update rule below has never
      // allowed. Existing documents that already contain createdAt remain
      // fully compatible; see the update rule's comment.
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.keys()
            .hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt']);

      // Only the document owner may update, only approved fields may
      // change value, and uid/document ownership is immutable.
      //
      // IMPORTANT: this uses diff().affectedKeys() (changed VALUES only),
      // not keys() (all keys present). A legacy document that already
      // contains emailLower and/or createdAt can still be updated as long
      // as those fields' values are left unchanged - they simply never
      // appear in the diff, so no live-data migration is required for
      // existing profiles to remain editable. Any attempt to add, change,
      // or restore emailLower or createdAt on any document (legacy or
      // modern) is blocked because neither is in this allowlist.
      allow update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.displayName is string
        && request.resource.data.photoURL is string
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'updatedAt']);

      // Delete: self-only, unchanged from prior behavior.
      allow delete: if signedIn() && uid == request.auth.uid;
    }
  }
}
